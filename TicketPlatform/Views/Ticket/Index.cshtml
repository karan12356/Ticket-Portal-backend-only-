@{
    ViewBag.Title = "My Tickets";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>My Tickets</h2>
<ul id="ticketList"></ul>

<script>
fetch("http://localhost:7255/api/tickets")
    .then(res => res.json())
    .then(data => {
        data.forEach(t => {
            ticketList.innerHTML += `
                <li>
                    <a href="/Ticket/Details?id=${t.id}">
                        ${t.confirmationNumber} - ${t.status}
                    </a>
                </li>`;
        });
    });
</script>
